AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Invitation emails, sent through Resend. EMAIL_FROM must be an address on a
# domain verified in Resend, e.g. Taskwell <invites@example.com>.
# Links in emails are built from NEXTAUTH_URL.
RESEND_API_KEY=
EMAIL_FROM=

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

DATABASE_URL=

# Two-factor sign-in: encrypts each account's authenticator secret (AES-256-GCM).
# 32 random bytes, base64 or hex, e.g. `openssl rand -base64 32`. Server-only.
# Don't change it once accounts use 2FA: their secrets could no longer be read.
TWO_FACTOR_ENCRYPTION_KEY=

# Optional. How often the server looks for task reminders that are due, in
# milliseconds (default 20000, minimum 1000). REMINDER_SCHEDULER=off runs a
# server process without the reminder timer.
# REMINDER_POLL_MS=20000
